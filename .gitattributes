# Normalize project text files while preserving source datasets byte-for-byte.
* text=auto

data/raw/*.txt -text
# Source snapshots are evidence: preserve their recorded SHA-256 bytes on every OS.
outputs/benchmarks/**/source_snapshot/** -text
*.pdf binary
*.png binary
*.parquet binary
*.sqlite binary
*.joblib binary
# Các file chạy trong container Linux phải giữ xuống dòng LF.
infra/** text eol=lf
src/cmapss/hdfs/*.py text eol=lf
