<mxfile host="drawio" modified="2026-10-13T00:00:00.000Z" version="31.4.5">
  <diagram id="fd001-pipeline" name="FD001 overall pipeline">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="laneA" value="A. Dự đoán RUL" style="swimlane;html=1;rounded=1;arcSize=4;startSize=30;fillColor=#FAFAFA;swimlaneFillColor=#FAFAFA;strokeColor=#BDBDBD;dashed=1;fontStyle=1;fontSize=14;fontColor=#424242;align=left;spacingLeft=14;swimlaneLine=0;collapsible=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="460" height="717" as="geometry" /></mxCell>
        <mxCell id="laneB" value="B. Theo dõi tín hiệu" style="swimlane;html=1;rounded=1;arcSize=4;startSize=30;fillColor=#FAFAFA;swimlaneFillColor=#FAFAFA;strokeColor=#BDBDBD;dashed=1;fontStyle=1;fontSize=14;fontColor=#424242;align=left;spacingLeft=14;swimlaneLine=0;collapsible=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="600" y="455" width="460" height="577" as="geometry" /></mxCell>
        <mxCell id="acquire" value="&lt;b&gt;1. Tải dữ liệu từ NASA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;File CMAPSSData.zip&lt;br&gt;Kiểm tra MD5 và SHA-256&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="raw" value="&lt;b&gt;2. Dữ liệu gốc FD001 (Bronze)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;File text train và test&lt;br&gt;Giữ nguyên, không ghi đè&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E8F5E9;strokeColor=#43A047;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="hdfs" value="&lt;b&gt;Chạy lại trên Hadoop (HDFS)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;MapReduce tính lại bảng động cơ&lt;br&gt;Khớp 200/200; không dùng cho mô hình&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;" vertex="1" parent="1"><mxGeometry x="620" y="170" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="validate" value="&lt;b&gt;3. Đọc và kiểm tra dữ liệu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Đúng cột, không trùng khóa&lt;br&gt;Cycle liên tục; tính RUL cho train&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="etl" value="&lt;b&gt;A1. Lưu bảng sạch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Silver: quan sát, nhãn RUL train&lt;br&gt;Gold: tổng hợp động cơ (Parquet, SQLite)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="features" value="&lt;b&gt;A2. Tạo đặc trưng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Cửa sổ 30 cycles: 21 sensor × 6 thống kê&lt;br&gt;126 đặc trưng, 27.927 dòng&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="model" value="&lt;b&gt;A3. Huấn luyện mô hình&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Chia 5 phần theo động cơ (GroupKFold)&lt;br&gt;RUL dự đoán ≤ 30: cảnh báo mức 2&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="predictions" value="&lt;b&gt;A4. Dự đoán 100 động cơ test&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Lưu kết quả&lt;br&gt;trước khi mở đáp án&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#FFF3E0;strokeColor=#EF6C00;" vertex="1" parent="1"><mxGeometry x="60" y="920" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="eval" value="&lt;b&gt;A5. Chấm điểm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;So với RUL thật của test&lt;br&gt;MAE, RMSE, NASA score&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="60" y="1060" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="eda" value="&lt;b&gt;B1. Khám phá dữ liệu (EDA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Sensor thay đổi thế nào khi máy già đi&lt;br&gt;Kiểm định Wilcoxon, hiệu chỉnh FDR&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="620" y="500" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="ewma" value="&lt;b&gt;B2. Làm mượt tín hiệu (EWMA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;14 sensor có xu hướng, span 10&lt;br&gt;Chỉ dùng cycle hiện tại và trước đó&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="620" y="640" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="hi" value="&lt;b&gt;B3. Chỉ số sức khỏe&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Health Index: gộp 21 sensor bằng PCA&lt;br&gt;Học trên train, không dùng nhãn RUL&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="620" y="780" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="anomaly" value="&lt;b&gt;B4. Phát hiện bất thường&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Chỉ số ≤ −3 trong 5 cycles liền nhau&lt;br&gt;Cảnh báo mức 1&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="620" y="920" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="labels" value="&lt;b&gt;Đáp án test (RUL_FD001.txt)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;RUL thật của 100 động cơ test&lt;br&gt;Chỉ mở sau khi đã lưu dự đoán&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E8F5E9;strokeColor=#43A047;" vertex="1" parent="1"><mxGeometry x="620" y="1060" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="maintenance" value="&lt;b&gt;Lịch bảo trì 100 động cơ test&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;RUL ≤ 30: cần bảo trì&lt;br&gt;Bất thường: theo dõi thêm&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#FFF3E0;strokeColor=#EF6C00;" vertex="1" parent="1"><mxGeometry x="340" y="1210" width="420" height="96" as="geometry" /></mxCell>
