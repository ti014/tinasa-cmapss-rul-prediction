# Repository Harness (local only)
/AGENTS.md
/.agents/
/.harness-core/
/.harness-backup/
/docs/
/scripts/bin/harness
/scripts/bin/harness.exe

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Python environments and packaging
.venv/
node_modules/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/
# Notebooks 00–06 write fresh results for each kernel session.
/outputs/notebook0[0-6]/

# Environment variables and secrets
# Local assistant state must never enter the project history.
/auth.json
/.cockpit_codex_auth.json
/.codex-global-state.json
/config.toml
/installation_id
/goals_*.sqlite*
/logs_*.sqlite*
/memories_*.sqlite*
/queue_*.sqlite*
/state_*.sqlite*
/sqlite/
/skills/
/slides/node_modules.runtime-link/
.env
.env.*
!.env.example
*.pem
*.key

# Logs and temporary files
*.log
*.blg
# LaTeX build intermediates; keep .tex sources and final PDFs.
*.aux
*.bbl
*.lof
*.lot
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
# Dated slide exports are local copies of the main deck.
slides/cmapss_fd001_presentation_*.pptx
logs/
tmp/
# Rebuildable per-fit predictions; keep summary artifacts and manifests in Git.
outputs/experiments/rul_improvement/*/fit_cache/
outputs/experiments/followup/**/fit_cache/
outputs/experiments/tree_comparison/*/fit_cache/
outputs/experiments/lightgbm_comparison/*/fit_cache/
# Smoke runs only check wiring; study runs keep the reported evidence.
outputs/experiments/*/*smoke*/
# Frozen inputs are rebuildable; manifests keep their SHA-256 hashes.
outputs/experiments/**/frozen_*_features.parquet
outputs/experiments/**/source_artifact_snapshot/*.parquet
temp/
*.tmp
*.bak

# IDE and editor settings
.idea/
.vscode/
*.swp
*.swo

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Chỉ giữ hai lần chạy thử nghiệm còn được dashboard, notebook 05 và slide đọc.
# Các lần chạy khác vẫn nằm trên máy và trong lịch sử git (commit 1e73c96).
/outputs/experiments/*
!/outputs/experiments/README.md
!/outputs/experiments/rul_improvement/
/outputs/experiments/rul_improvement/*
!/outputs/experiments/rul_improvement/20260928_rebuild/
!/outputs/experiments/followup/
