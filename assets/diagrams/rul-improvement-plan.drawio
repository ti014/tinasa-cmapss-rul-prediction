<mxfile host="drawio" modified="2026-10-13T00:00:00.000Z" version="31.4.5">
  <diagram id="rul-improvement-plan" name="RUL improvement plan">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="640" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="fold" value="Lặp lại cho mỗi fold" style="swimlane;html=1;rounded=1;arcSize=4;startSize=30;fillColor=#FAFAFA;swimlaneFillColor=#FAFAFA;strokeColor=#BDBDBD;dashed=1;fontStyle=1;fontSize=14;fontColor=#424242;align=left;spacingLeft=14;swimlaneLine=0;collapsible=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="560" height="417" as="geometry" /></mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Chốt mốc so sánh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Lưu kết quả mô hình gốc (baseline)&lt;br&gt;Cùng động cơ, cùng cycle, ngưỡng cảnh báo 30&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E8F5E9;strokeColor=#43A047;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="520" height="96" as="geometry" /></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Thử độ dài cửa sổ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;10, 20 hoặc 30 cycles&lt;br&gt;Chọn bằng CV 3 phần bên trong&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="60" y="215" width="520" height="96" as="geometry" /></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Chỉnh tham số mô hình&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;24 cấu hình HGB&lt;br&gt;Chọn bằng CV 3 phần bên trong&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="60" y="345" width="520" height="96" as="geometry" /></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Tăng trọng số mẫu sắp hỏng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;3 phương án&lt;br&gt;Giữ cân bằng giữa các động cơ&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="60" y="475" width="520" height="96" as="geometry" /></mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Chấm trên phần validation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Gộp 5 phần, so với baseline&lt;br&gt;Bootstrap 10.000 lần theo động cơ&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#E1F5FE;strokeColor=#0277BD;" vertex="1" parent="1"><mxGeometry x="60" y="655" width="520" height="96" as="geometry" /></mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. Chọn cấu hình cuối, dự đoán test&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Học lại trên toàn bộ train&lt;br&gt;Lưu 100 dự đoán rồi mới mở đáp án&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#FFF3E0;strokeColor=#EF6C00;" vertex="1" parent="1"><mxGeometry x="60" y="785" width="520" height="96" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#757575;fontFamily=Arial;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#757575;fontFamily=Arial;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
