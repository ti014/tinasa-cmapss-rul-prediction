<mxfile host="app.diagrams.net"><diagram id="rul-plan" name="Kế hoạch cải thiện"><mxGraphModel dx="1000" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="QUY TRÌNH THỬ NGHIỆM CẢI THIỆN RUL" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="900" height="45" as="geometry"/></mxCell>
<mxCell id="a" value="1. Lưu baseline và chốt cách đánh giá&lt;br&gt;Cùng engine, cùng cycle; ngưỡng cảnh báo 30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="1"><mxGeometry x="180" y="95" width="560" height="75" as="geometry"/></mxCell>
<mxCell id="group" value="Trong mỗi outer fold: chỉ dùng outer train để chọn cấu hình" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=14;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="130" y="210" width="660" height="395" as="geometry"/></mxCell>
<mxCell id="b" value="2. So sánh window 10 / 20 / 30&lt;br&gt;Cùng khóa đánh giá từ cycle 30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;" vertex="1" parent="1"><mxGeometry x="180" y="265" width="560" height="75" as="geometry"/></mxCell>
<mxCell id="c" value="3. Chỉnh tham số mô hình&lt;br&gt;24 cấu hình, chọn bằng inner CV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;" vertex="1" parent="1"><mxGeometry x="180" y="380" width="560" height="75" as="geometry"/></mxCell>
<mxCell id="d" value="4. Ưu tiên mẫu sắp hỏng&lt;br&gt;3 phương án; giữ cân bằng từng engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;" vertex="1" parent="1"><mxGeometry x="180" y="495" width="560" height="75" as="geometry"/></mxCell>
<mxCell id="e" value="5. Đánh giá trên engine của outer validation&lt;br&gt;Gộp 5 folds; so với baseline; kiểm tra đánh đổi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="180" y="645" width="560" height="85" as="geometry"/></mxCell>
<mxCell id="f" value="Chọn cấu hình cuối bằng CV trên toàn bộ train&lt;br&gt;Fit lại → ghi 100 test predictions → ghép nhãn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;" vertex="1" parent="1"><mxGeometry x="180" y="775" width="560" height="85" as="geometry"/></mxCell>
<mxCell id="g" value="6. Cập nhật báo cáo và bằng chứng&lt;br&gt;Tách kết quả trajectory và test endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="1"><mxGeometry x="180" y="905" width="560" height="75" as="geometry"/></mxCell>
<mxCell id="foot" value="Test đã được xem trước đây. Không dùng kết quả test để chỉnh cấu hình trong đợt này." style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="1000" width="900" height="45" as="geometry"/></mxCell>
